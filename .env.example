# Rename this file to .env and fill in your real values. Never commit the real .env file.

PORT=5000

# Get these from your Flutterwave dashboard -> Settings -> API Keys
# Use the TEST keys while building, swap to LIVE keys only when you're ready to go live
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxx
FLW_WEBHOOK_HASH=choose-a-random-secret-string-and-set-same-in-flutterwave-dashboard

# Used to sign login tokens - make this a long random string, don't reuse it anywhere else
JWT_SECRET=change-this-to-something-long-and-random

# Where the frontend lives, used for CORS
FRONTEND_URL=http://localhost:5500
